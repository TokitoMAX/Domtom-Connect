# Activer le moteur de réécriture
RewriteEngine On

# Forcer HTTPS (doit être en premier)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Masquer index.html de toutes les URLs
# Redirection pour supprimer index.html de toutes les URLs (racine et sous-dossiers)
# Exemple : /index.html -> /
# Exemple : /services/index.html -> /services
# Exemple : /blog/index.html -> /blog
# Exemple : /blog/article/index.html -> /blog/article

# Cas 1 : Redirection pour la racine uniquement (/index.html -> /)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Cas 2 : Redirection pour tous les sous-dossiers (/dossier/index.html -> /dossier)
RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)index\.html[\s?] [NC]
RewriteRule ^(.*/)index\.html$ /$1 [R=301,L]

# Supprimer le slash final si présent (sauf pour la racine)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# Servir index.html pour tous les dossiers sans l'afficher dans l'URL
DirectoryIndex index.html

# Redirections pour éviter le contenu dupliqué
# Redirection blog.html vers /blog
RewriteCond %{THE_REQUEST} \s/+blog\.html[\s?] [NC]
RewriteRule ^blog\.html$ /blog [R=301,L]

# Redirection pourquoi-j-ai-cree-domtom-connect-episode-1 vers /blog/pourquoi-j-ai-cree-domtom-connect-episode-1
RewriteCond %{THE_REQUEST} \s/+pourquoi-j-ai-cree-domtom-connect-episode-1[\s?] [NC]
RewriteRule ^pourquoi-j-ai-cree-domtom-connect-episode-1/?$ /blog/pourquoi-j-ai-cree-domtom-connect-episode-1 [R=301,L]

