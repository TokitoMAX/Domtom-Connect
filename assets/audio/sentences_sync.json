    "text": "Monter une boîte ?"
  },
  {
    "start": 1.67,
    "end": 3.29,
    "text": "Gérer une boîte ?"
  },
  {
    "start": 3.29,
    "end": 4.9,
    "text": "C'est jamais simple."
  },
  {
    "start": 4.9,
    "end": 6.49,
    "text": "Tu te sens bloqué ?"
  },
  {
    "start": 6.49,
    "end": 7.82,
    "text": "Débordé ?"
  },
  {
    "start": 7.82,
    "end": 9.67,
    "text": "Seul face à tes galères ?"
  },
  {
    "start": 9.67,
    "end": 12.28,
    "text": "Chez Domme Tomme Connect, zéro blabla."
  },
  {
    "start": 12.28,
    "end": 14.23,
    "text": "On n'a pas la science infuse."
  },
  {
    "start": 14.23,
    "end": 16.52,
    "text": "On ne prétend pas être meilleurs que toi."
  },
  {
    "start": 16.52,
    "end": 18.78,
    "text": "Mais notre rôle, il est clair."
  },
  {
    "start": 18.78,
    "end": 20.53,
    "text": "On s'assoit avec toi."
  },
  {
    "start": 20.53,
    "end": 22.53,
    "text": "On écoute tes vrais blocages."
  },
  {
    "start": 22.53,
    "end": 24.01,
    "text": "On structure."
  },
  {
    "start": 24.01,
    "end": 25.54,
    "text": "On copilote."
  },
  {
    "start": 25.54,
    "end": 27.45,
    "text": "On avance en tête-à-tête."
  },
  {
    "start": 27.45,
    "end": 29.86,
    "text": "Tout seul dans ton coin, tu stagnes."
  },
  {
    "start": 29.86,
    "end": 31.83,
    "text": "Ensemble, on débloque tout."
  },
  {
    "start": 31.83,
    "end": 35.45,
    "text": "Caraïbes, Afrique, diaspora : viens échanger avec nous."
  },
  {
    "start": 35.45,
    "end": 36.78,
    "text": "Stay Co."
  }
