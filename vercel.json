{
    "cleanUrls": true,
    "redirects": [
        {
            "source": "/dashboard",
            "destination": "/mon-espace",
            "permanent": true
        },
        {
            "source": "/dashboard.html",
            "destination": "/mon-espace",
            "permanent": true
        },
        {
            "source": "/mon-projet",
            "destination": "/epopee",
            "permanent": true
        },
        {
            "source": "/mon-projet.html",
            "destination": "/epopee",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/marketplace/company/:id",
            "destination": "/marketplace/profile-detail-company.html?id=:id"
        },
        {
            "source": "/marketplace/expert/:id",
            "destination": "/marketplace/profile-detail-expert.html?id=:id"
        }
    ]
}